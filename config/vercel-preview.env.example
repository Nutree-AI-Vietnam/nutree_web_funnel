# Copy to .env.preview.local, fill the blanks, then run:
# ./scripts/import-vercel-env.sh preview .env.preview.local
#
NEXT_PUBLIC_API_BASE_URL=

# RevenueCat Web sandbox configuration.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
# Existing sandbox offering for Vietnam's current Paddle prices.
NEXT_PUBLIC_REVENUECAT_WEB_OFFERING_ID=
# Sandbox offering containing the new USD Paddle prices for non-Vietnam markets.
NEXT_PUBLIC_REVENUECAT_WEB_OFFERING_ID_INTL=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_4_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_12_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_52_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_1_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_1_WEEK_ENABLED=false
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# English survey (/survey/en). Used only together with META_CONVERSIONS_API_ACCESS_TOKEN_EN.
# Set that token in Vercel as a Sensitive variable. If either is empty, English uses the default pair.
NEXT_PUBLIC_META_PIXEL_ID_EN=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_AIRBRIDGE_APP_NAME=
NEXT_PUBLIC_AIRBRIDGE_WEB_TOKEN=
NEXT_PUBLIC_AIRBRIDGE_TRACKING_LINK=
NEXT_PUBLIC_APPSTORE_URL=
NEXT_PUBLIC_PLAYSTORE_URL=
NUTREE_ANDROID_SHA256_CERT_FINGERPRINTS=
# Required for Preview App Links. Empty → assetlinks.json is [] (fail closed).
