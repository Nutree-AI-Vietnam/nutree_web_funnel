# Copy to .env.production.local, fill the blanks, then run:
# ./scripts/import-vercel-env.sh production .env.production.local
#
# This target must use the Firebase project configured for the production NutreeAI app.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nutree-ai
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paddle live catalog and browser token.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=live
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_AIRBRIDGE_APP_NAME=
NEXT_PUBLIC_AIRBRIDGE_WEB_TOKEN=
NEXT_PUBLIC_AIRBRIDGE_TRACKING_LINK=
NEXT_PUBLIC_APPSTORE_URL=
NEXT_PUBLIC_PLAYSTORE_URL=
