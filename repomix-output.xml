        <div className="h-2 flex-1 overflow-hidden rounded-full bg-border-brand">
          <div
            className="h-full rounded-full bg-teal-brand transition-all"
            style={{ width: `${progress}%` }}
          />
        </div>
      </div>
      <div className="flex flex-1 flex-col">{children}</div>
    </main>
  );
}
