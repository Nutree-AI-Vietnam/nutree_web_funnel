  mix-blend-mode: multiply;
  background-image:
    radial-gradient(circle at 25% 18%, rgb(26 71 57 / 0.08) 0 1px, transparent 1px),
    radial-gradient(circle at 78% 76%, rgb(41 182 161 / 0.10) 0 1px, transparent 1px);
  background-size: 18px 18px, 23px 23px;
}

.surface-grain {
  position: relative;
}

.surface-grain::before {
  position: absolute;
  inset: 0;
  pointer-events: none;
  content: "";
  opacity: 0.16;
  mix-blend-mode: multiply;
  background-image:
    radial-gradient(circle at 18% 24%, rgb(26 71 57 / 0.10) 0 0.7px, transparent 0.8px),
    radial-gradient(circle at 78% 64%, rgb(41 182 161 / 0.12) 0 0.7px, transparent 0.8px);
  background-size: 15px 15px, 19px 19px;
}

@keyframes soft-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes subtle-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgb(41 182 161 / 0.22);
  }
  50% {
    box-shadow: 0 0 0 7px rgb(41 182 161 / 0);
  }
}

@keyframes beam-drift {
  0% {
    transform: translate3d(-18%, -8%, 0) rotate(18deg);
    opacity: 0;
  }
  18%,
  74% {
    opacity: 0.9;
  }
  100% {
    transform: translate3d(34%, 24%, 0) rotate(18deg);
    opacity: 0;
  }
}

@keyframes float-panel {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.animate-soft-enter {
  animation: soft-enter 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* Premium CTA: subtle top sheen + shine sweep on hover */
.cta-premium {
  position: relative;
  isolation: isolate;
  background:
    linear-gradient(180deg, rgb(255 255 255 / 0.10), rgb(255 255 255 / 0) 42%),
    linear-gradient(135deg, #1c5546 0%, var(--color-forest) 48%, #0f2c23 100%);
  box-shadow: var(--shadow-cta);
}

.cta-premium::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.22) 48%, transparent 66%);
  transform: translateX(-120%);
  transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.cta-premium:hover::after {
  transform: translateX(120%);
}

.cta-premium > * {
  position: relative;
  z-index: 2;
}

/* Hairline gradient border for glass surfaces */
.hairline-glass {
  box-shadow:
    var(--ring-hairline),
    var(--shadow-e2);
}


.animate-subtle-pulse {
  animation: subtle-pulse 1600ms ease-out infinite;
}

.animate-float-panel {
  animation: float-panel 5s ease-in-out infinite;
}

.aceternity-beam {
  position: absolute;
  top: 12%;
  left: 0;
  height: 14rem;
  width: 46rem;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgb(41 182 161 / 0.28), rgb(255 255 255 / 0.78), transparent);
  filter: blur(18px);
  transform: rotate(18deg);
  animation: beam-drift 8s ease-in-out infinite;
}

.aceternity-beam-one {
  animation-delay: -1s;
}

.aceternity-beam-two {
  top: 36%;
  width: 36rem;
  animation-delay: -4s;
}

.aceternity-beam-three {
  top: 62%;
  width: 30rem;
  animation-delay: -6s;
}

/* Reflection trajectory draw-in */
.reflect-line {
  stroke-dasharray: 340;
  stroke-dashoffset: 340;
  animation: promo-draw 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
}

.reflect-fade {
  opacity: 0;
  animation: reflect-fade-in 0.6s ease-out 1.15s forwards;
}

@keyframes reflect-fade-in {
  to {
    opacity: 1;
  }
}

.wheel-picker-scroll {
  scrollbar-width: none;
}

.wheel-picker-scroll::-webkit-scrollbar {
  display: none;
}

/* Skeletal shimmer for loading states */
.shimmer {
  position: relative;
  overflow: hidden;
  background: rgb(23 69 58 / 0.06);
}

.shimmer::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.6), transparent);
  animation: shimmer 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}

.promo-draw {
  stroke-dasharray: 180;
  stroke-dashoffset: 180;
  animation: promo-draw 1.2s ease-out forwards;
}

.promo-pulse-dot {
  animation: promo-dot 1.8s ease-in-out infinite;
  transform-origin: center;
}

.promise-line {
  stroke-dasharray: 420;
  stroke-dashoffset: 420;
  animation: promo-draw 1.1s ease-out 120ms forwards;
}

.promise-line-muted {
  stroke-dasharray: 7 7;
  animation: promise-muted 3s linear infinite;
}

.promise-dot {
  opacity: 0;
  transform-origin: center;
  animation: promise-dot 420ms ease-out 950ms forwards;
}

@keyframes promo-draw {
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes promo-dot {
  0%,
  100% {
    opacity: 0.72;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.12);
  }
}

@keyframes promise-muted {
  to {
    stroke-dashoffset: -28;
  }
}

@keyframes promise-dot {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
