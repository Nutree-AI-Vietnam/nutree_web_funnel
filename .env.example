NEXT_PUBLIC_API_BASE_URL=
# Server-only credential shared with MealTrack's web-funnel BFF boundary.
WEB_FUNNEL_BFF_SHARED_SECRET=
NEXT_PUBLIC_GA4_ID=
# PostHog project token (phc_...). Dev locally, staging on preview, prod on production.
# Empty skips session replay. Host is fixed to US Cloud in the client.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only Conversions API token (Events Manager > pixel > Settings > Conversions API > Generate access token).
# Empty keeps /api/meta/events inert. Store it in Vercel as a Sensitive variable.
META_CONVERSIONS_API_ACCESS_TOKEN=
# Testing only: events carrying this code show in Test Events, but Meta still counts them. Keep empty in production.
META_CONVERSIONS_API_TEST_EVENT_CODE=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Server-only TikTok Events API token (Events Manager > pixel > Settings > Events API).
# Empty keeps /api/tiktok/events inert. Store it in Vercel as a Sensitive variable.
TIKTOK_EVENTS_API_ACCESS_TOKEN=
# Testing only: events carrying this code show in Test Events and are not counted. Keep empty in production.
TIKTOK_EVENTS_API_TEST_CODE=
NEXT_PUBLIC_AIRBRIDGE_APP_NAME=
NEXT_PUBLIC_AIRBRIDGE_WEB_TOKEN=
NEXT_PUBLIC_AIRBRIDGE_TRACKING_LINK=
NEXT_PUBLIC_APPSTORE_URL=
NEXT_PUBLIC_PLAYSTORE_URL=
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_WEB_OFFERING_ID=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_4_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_12_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_52_WEEK=
NEXT_PUBLIC_REVENUECAT_WEB_PACKAGE_1_WEEK=
# true replaces the 52-week card/package with the 1-week card/package.
NEXT_PUBLIC_REVENUECAT_WEB_1_WEEK_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side comma/newline-separated release SHA-256 fingerprints for the
# environment's Android App Link association response.
NUTREE_ANDROID_SHA256_CERT_FINGERPRINTS=
